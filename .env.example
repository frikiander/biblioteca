# ==============================================================================
# BIBLIOTECA MIGUEL OTERO SILVA - COLEGIO INTEGRAL EL MANGLAR
# PLANTILLA DE VARIABLES DE ENTORNO / CREDENCIALES
# ==============================================================================
# Copia este archivo como '.env' o '.env.local' y asigna tus valores reales.
# NUNCA subas tu archivo '.env' con claves secretas a GitHub.

# ------------------------------------------------------------------------------
# 1. GOOGLE BOOKS API (Catalogación automática por ISBN)
# ------------------------------------------------------------------------------
# Obtén tu API Key gratuita en: https://console.cloud.google.com/
# 1. Crea un proyecto en Google Cloud Console.
# 2. Ve a "APIs y Servicios" > "Biblioteca" y habilita "Books API".
# 3. Ve a "Credenciales" > "Crear credenciales" > "Clave de API".
VITE_GOOGLE_BOOKS_API_KEY=""
NEXT_PUBLIC_GOOGLE_BOOKS_API_KEY=""

# ------------------------------------------------------------------------------
# 2. SUPABASE (Base de datos PostgreSQL + Storage + Auth + RLS)
# ------------------------------------------------------------------------------
# Obtén estas claves en: https://supabase.com/dashboard -> Tu Proyecto -> Project Settings -> API
# URL del proyecto (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""

# Clave pública anónima (anon / public key) para consultas desde el navegador
VITE_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clave de rol de servicio (service_role)
# ¡PRECAUCIÓN!: Solo para scripts de servidor o migraciones locales. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# 3. GEMINI AI (Opcional - Para funciones de asistencia con LLM)
# ------------------------------------------------------------------------------
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
VITE_GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN DE LA APLICACIÓN
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"
